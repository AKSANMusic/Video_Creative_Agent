# Copy to .env and fill in. Resolved by pydantic-settings (env file + process env).
# Required for any real Replicate API call.
REPLICATE_API_TOKEN=

# Optional overrides (defaults shown). Leave blank to use defaults.
# Florence-2 model identifier on Replicate.
ACE_FLORENCE_MODEL=microsoft/florence-2
# LLaVA-NeXT model identifier on Replicate.
ACE_LLAVA_MODEL=yorickvp/llava-v1.6-vicuna-13b
# Local sentence-transformers model for binary embedding of captions.
ACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Target embedding dimension (Matryoshka truncation / zero-pad target).
ACE_EMBEDDING_DIM=512
# Max captions embedded per model.encode call. Lower = less peak memory (OOM guard for big folders).
ACE_EMBEDDING_BATCH_SIZE=32
# Per-call API timeout in seconds.
ACE_REQUEST_TIMEOUT_S=60
# SQLite database path (relative to CWD or absolute).
ACE_DB_PATH=creative_engine.db

# --- Stage 2: Audio analysis ---
# librosa resample target sample rate (Hz).
ACE_AUDIO_SAMPLE_RATE=22050
# librosa hop length (frames). Larger = faster, coarser.
ACE_AUDIO_HOP_LENGTH=512
# Target number of structural sections.
ACE_AUDIO_N_SEGMENTS=8
# Optional CLAP cross-modal tagging (heavy; off by default).
ACE_CLAP_ENABLED=false
ACE_CLAP_MODEL=laion/larger_clap_general
ACE_CLAP_DEVICE=cpu

# --- Stage 3: narrative sequencer ---
# Per-section image count above which exact DP falls back to greedy.
ACE_SEQUENCER_DP_THRESHOLD=12
# Blend weight [0,1] for color continuity vs embedding similarity.
ACE_SEQUENCER_CONTINUITY_WEIGHT=0.5
# Beat grid to lock cuts to: 'downbeats' or 'beats'.
ACE_SEQUENCER_CUT_ON=downbeats
#
# Per-section director override (NOT an env var). Set `continuity_weight_override`
# on individual `Section` objects in audio_map.json to steer cut dynamics:
#   None  -> use the global ACE_SEQUENCER_CONTINUITY_WEIGHT above
#   0.0-1.0 -> win over the global for that section only.
# Lower = harder/more dynamic cuts (embedding similarity dominates);
# Higher = smoother/more color-stable cuts. See HANDOVER.md §2.4.

# --- Stage 4: render ---
# ffmpeg video encoder. Validated at config load against the known registry:
#   libx264, libx265, h264_nvenc, hevc_nvenc, h264_vaapi, hevc_vaapi,
#   h264_videotoolbox, hevc_videotoolbox.
# The CLI flag --codec overrides this per-render. See HANDOVER.md §4.1.
ACE_VIDEO_CODEC=libx264
